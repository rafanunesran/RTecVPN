{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RTecVPN",
  "version": "0.1.0",
  "identifier": "br.com.rtec.vpn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RTecVPN",
        "width": 400,
        "height": 680,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "VPN gratuita baseada em WireGuard",
    "linux": {
      "deb": {
        "depends": [
          "wireguard-tools",
          "openvpn",
          "policykit-1"
        ]
      },
      "rpm": {
        "depends": [
          "wireguard-tools",
          "openvpn",
          "polkit"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4ODhFRDJGQTk4NzM0NTQKUldSVU5JZXBMKzJJbUhIeVZacEZYUWdHV0dFTHpMeWZKME9NTEhYUVdYSU50NzA3TGdiVURsRXoK",
      "endpoints": [
        "https://github.com/rafanunesran/RTecVPN/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
